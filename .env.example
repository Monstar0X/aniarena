# --- Telegram (https://my.telegram.org/apps  +  @BotFather) ---
BOT_TOKEN=
API_ID=
API_HASH=

# --- MongoDB (Atlas free tier works fine) ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
DATABASE_NAME=aniarena

# --- Admin ---
OWNER_IDS=            # comma separated Telegram ids: /stats and /broadcast
LOG_CHANNEL=0         # optional channel id: get a ping whenever the bot is added to a group

# --- Branding ---
UPDATES_URL=https://t.me/+CnJ6ob7M-MdkOGFl   # shown as an "Updates channel" button; empty hides it

# --- Tuning ---
TZ_OFFSET_HOURS=0     # when the daily puzzle rolls over (UTC+N). India = 5 (use 5 for UTC+5:30 close enough)
CATALOG_SIZE=600      # how many popular anime to pull from AniList
REFRESH_DAYS=7
